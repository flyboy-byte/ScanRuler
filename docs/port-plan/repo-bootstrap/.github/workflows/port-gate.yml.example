# Disabled example. Review action pins/paths and implement all xtask commands
# before installing this as .github/workflows/port-gate.yml.
# No missing Rust workspace/runner is allowed to count as success.
name: Rust port gate
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: port-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
  gate:
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - name: Require product prerequisites
        run: |
          test -f rust/Cargo.toml
          test -f rust/rust-toolchain.toml
          test -f docs/port-plan/reference-pin.json
      - name: Install pinned toolchain and Wasm target
        working-directory: rust
        run: |
          rustup show
          rustup target add wasm32-unknown-unknown
      - name: Same gate contributors run
        working-directory: rust
        run: cargo xtask ci
      - name: Full regression and exact-base ratchet
        working-directory: rust
        run: cargo xtask diff-ci
# diff-ci must obtain/build the exact-base validated reports, verify pinned
# source/fixture/seed/comparator identities and fail on missing artifacts.
# It must run real original and Rust adapters, not trust PR-supplied reports.
# Configure report artifacts, browser/OS jobs and branch protection in P38.
